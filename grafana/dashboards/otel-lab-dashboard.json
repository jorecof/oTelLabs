{
  "title": "OTel Lab \u2014 Pipeline de Observabilidad End-to-End",
  "uid": "otel-lab-main",
  "tags": [
    "otel",
    "sre",
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total, service_name)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "SLI-1: Tasa de Disponibilidad (% requests exitosos)",
      "description": "SLI de disponibilidad: requests 2xx / total requests. SLO objetivo: \u2265 99.5%",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * (\n  sum(rate(http_requests_total{status=~'2..', service_name=~'$service'}[5m]))\n  /\n  sum(rate(http_requests_total{service_name=~'$service'}[5m]))\n)",
          "legendFormat": "Disponibilidad %",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 95,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "SLI-2: Latencia p50 / p95 / p99 (segundos)",
      "description": "Distribuci\u00f3n de latencia HTTP. SLO objetivo: p95 < 500ms",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service_name=~'$service'}[5m])) by (le, service_name))",
          "legendFormat": "p50 \u2014 {{service_name}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service_name=~'$service'}[5m])) by (le, service_name))",
          "legendFormat": "p95 \u2014 {{service_name}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service_name=~'$service'}[5m])) by (le, service_name))",
          "legendFormat": "p99 \u2014 {{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "SLI-3: Error Rate (tasa de errores 5xx)",
      "description": "SLI de error rate. SLO objetivo: \u2264 0.5%. Burn rate = error_rate / 0.005",
      "type": "timeseries",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{status=~'5..', service_name=~'$service'}[5m])) by (service_name)\n  /\nsum(rate(http_requests_total{service_name=~'$service'}[5m])) by (service_name)",
          "legendFormat": "Error Rate % \u2014 {{service_name}}"
        },
        {
          "expr": "0.5",
          "legendFormat": "SLO threshold (0.5%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "SLI-4: Throughput (RPS \u2014 Requests Per Second)",
      "description": "Tr\u00e1fico total hacia los microservicios. Un drop s\u00fabito indica incidente.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service_name=~'$service'}[5m])) by (service_name)",
          "legendFormat": "RPS \u2014 {{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 5,
      "title": "CPU Overhead \u2014 Comparativa con/sin OTel",
      "description": "Uso de CPU de los servicios instrumentados. Ver Fase 4 para comparativa baseline.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{service_name=~'$service'}[5m]) * 100",
          "legendFormat": "CPU % \u2014 {{service_name}}"
        },
        {
          "expr": "rate(otelcol_process_cpu_seconds{} [5m]) * 100",
          "legendFormat": "CPU % \u2014 OTel Collector"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 6,
      "title": "OTel Collector \u2014 Spans enviados / rechazados / en cola",
      "description": "Salud del pipeline del Collector. Spans rechazados = se\u00f1al de sobrecarga o error de red al backend.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(otelcol_exporter_sent_spans_total[5m])",
          "legendFormat": "Spans enviados/s \u2014 {{exporter}}"
        },
        {
          "expr": "rate(otelcol_exporter_enqueue_failed_spans_total[5m])",
          "legendFormat": "\u26a0\ufe0f Spans rechazados/s \u2014 {{exporter}}"
        },
        {
          "expr": "otelcol_exporter_queue_size",
          "legendFormat": "Cola de spans \u2014 {{exporter}}"
        },
        {
          "expr": "rate(otelcol_processor_dropped_spans_total[5m])",
          "legendFormat": "\ud83d\udd34 Spans descartados \u2014 memory_limiter"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byNamePattern",
              "options": ".*rechazados.*|.*descartados.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Burn Rate \u2014 Velocidad de consumo del Error Budget",
      "description": "Burn Rate = error_rate_actual / error_rate_SLO (SLO=99.5% \u2192 error_rate_SLO=0.005). BR > 14.4 en 1h \u2192 alerta PAGE.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 6,
        "h": 5
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(\n  sum(rate(http_requests_total{status=~'5..', service_name=~'$service'}[1h]))\n  /\n  sum(rate(http_requests_total{service_name=~'$service'}[1h]))\n) / 0.005",
          "legendFormat": "Burn Rate 1h",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Propagaci\u00f3n W3C TraceContext \u2014 Trazas cross-service",
      "description": "Span count por servicio. Si service-b aparece con trace_id de service-a \u2192 propagaci\u00f3n correcta.",
      "type": "table",
      "gridPos": {
        "x": 6,
        "y": 15,
        "w": 18,
        "h": 5
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service_name=~'service-a|service-b'}[5m])) by (service_name, status)",
          "legendFormat": "{{service_name}} \u2014 {{status}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "service_name": "Servicio",
              "status": "Status"
            }
          }
        }
      ]
    }
  ]
}